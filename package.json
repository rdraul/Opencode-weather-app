{
  "name": "02-weather",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run index.ts --watch",
    "typecheck": "bun check",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "verify": "bun run typecheck && bun test",
    "build": "bun run verify && bun build --compile --target=bun-windows-x64 index.ts --outfile=dist/weather.exe"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
